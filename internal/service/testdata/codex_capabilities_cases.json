{
  "description": "Codex 模型能力校验的前后端共用用例：Go 测试与 frontend/src/pages/account-pool/utils/codexModelCatalog.test.js 同时读取。规则以 Codex rust-v0.156.1 ModelInfo 反序列化为准，另含少量语义护栏。每个用例在 base 上先删除 remove 字段，再覆盖 set 字段。",
  "base": {
    "supported_reasoning_levels": [
      { "effort": "low", "description": "Fast responses with lighter reasoning" },
      { "effort": "medium", "description": "Balances speed and reasoning depth for everyday tasks" },
      { "effort": "high", "description": "Greater reasoning depth for complex problems" }
    ],
    "default_reasoning_level": "medium",
    "shell_type": "shell_command",
    "visibility": "list",
    "supported_in_api": true,
    "priority": 1,
    "support_verbosity": true,
    "default_verbosity": "low",
    "default_reasoning_summary": "none",
    "apply_patch_tool_type": "freeform",
    "web_search_tool_type": "text",
    "truncation_policy": { "mode": "tokens", "limit": 10000 },
    "experimental_supported_tools": [],
    "additional_speed_tiers": [],
    "context_window": 272000,
    "max_context_window": 272000,
    "effective_context_window_percent": 95,
    "input_modalities": ["text", "image"],
    "include_apps_usage_instructions": true,
    "availability_nux": null,
    "upgrade": null,
    "model_messages": { "instructions_template": "You are Codex, a coding agent." }
  },
  "cases": [
    { "name": "基础能力有效", "valid": true },
    { "name": "visibility 接受 none", "set": { "visibility": "none" }, "valid": true },
    { "name": "shell_type 接受 default 别名", "set": { "shell_type": "default" }, "valid": true },
    { "name": "思考等级接受 persistent 与自定义名", "set": { "supported_reasoning_levels": [{ "effort": "persistent", "description": "p" }, { "effort": "custom-deep", "description": "c" }], "default_reasoning_level": "custom-deep" }, "valid": true },
    { "name": "非推理模型允许空思考等级", "set": { "supported_reasoning_levels": [] }, "remove": ["default_reasoning_level"], "valid": true },
    { "name": "默认思考等级允许为 null", "set": { "default_reasoning_level": null }, "valid": true },
    { "name": "输入能力接受 audio", "set": { "input_modalities": ["text", "audio"] }, "valid": true },
    { "name": "输入能力缺省时按 Codex 默认处理", "remove": ["input_modalities"], "valid": true },
    { "name": "上下文窗口可以缺省", "remove": ["context_window", "max_context_window"], "valid": true },
    { "name": "上下文窗口允许为 null", "set": { "context_window": null, "max_context_window": null }, "valid": true },
    { "name": "有效上下文比例可以缺省", "remove": ["effective_context_window_percent"], "valid": true },
    { "name": "default_verbosity 允许为 null", "set": { "default_verbosity": null }, "valid": true },
    { "name": "apply_patch_tool_type 允许为 null", "set": { "apply_patch_tool_type": null }, "valid": true },
    { "name": "只有 base_instructions 也可以", "set": { "base_instructions": "You are Codex." }, "remove": ["model_messages"], "valid": true },
    { "name": "未知扩展字段原样保留", "set": { "future_flag": { "nested": [1, 2] } }, "valid": true },

    { "name": "apply_patch_tool_type 只允许 freeform", "set": { "apply_patch_tool_type": "function" }, "valid": false },
    { "name": "priority 超出 32 位整数", "set": { "priority": 3000000000 }, "valid": false },
    { "name": "priority 不能是小数", "set": { "priority": 1.5 }, "valid": false },
    { "name": "缺少 visibility", "remove": ["visibility"], "valid": false },
    { "name": "visibility 取值无效", "set": { "visibility": "public" }, "valid": false },
    { "name": "shell_type 取值无效", "set": { "shell_type": "bash" }, "valid": false },
    { "name": "default_reasoning_summary 不能为 null", "set": { "default_reasoning_summary": null }, "valid": false },
    { "name": "web_search_tool_type 不能为 null", "set": { "web_search_tool_type": null }, "valid": false },
    { "name": "有效上下文比例不能为 null", "set": { "effective_context_window_percent": null }, "valid": false },
    { "name": "有效上下文比例不能为 0", "set": { "effective_context_window_percent": 0 }, "valid": false },
    { "name": "有效上下文比例不能超过 100", "set": { "effective_context_window_percent": 101 }, "valid": false },
    { "name": "上下文窗口必须为正", "set": { "context_window": 0 }, "valid": false },
    { "name": "最大上下文不能小于上下文窗口", "set": { "max_context_window": 1000 }, "valid": false },
    { "name": "输入能力不能为空数组", "set": { "input_modalities": [] }, "valid": false },
    { "name": "输入能力不能为 null", "set": { "input_modalities": null }, "valid": false },
    { "name": "输入能力取值无效", "set": { "input_modalities": ["video"] }, "valid": false },
    { "name": "思考等级不能重复", "set": { "supported_reasoning_levels": [{ "effort": "low", "description": "a" }, { "effort": "low", "description": "b" }], "default_reasoning_level": "low" }, "valid": false },
    { "name": "思考等级名不能为空", "set": { "supported_reasoning_levels": [{ "effort": "", "description": "a" }] }, "remove": ["default_reasoning_level"], "valid": false },
    { "name": "思考等级必须包含 description", "set": { "supported_reasoning_levels": [{ "effort": "low" }], "default_reasoning_level": "low" }, "valid": false },
    { "name": "默认思考等级必须属于支持集合", "set": { "default_reasoning_level": "xhigh" }, "valid": false },
    { "name": "truncation_policy limit 不能为负", "set": { "truncation_policy": { "mode": "bytes", "limit": -1 } }, "valid": false },
    { "name": "truncation_policy mode 取值无效", "set": { "truncation_policy": { "mode": "chars", "limit": 10 } }, "valid": false },
    { "name": "experimental_supported_tools 必须是数组", "set": { "experimental_supported_tools": "shell" }, "valid": false },
    { "name": "additional_speed_tiers 不能为 null", "set": { "additional_speed_tiers": null }, "valid": false },
    { "name": "布尔字段不能是字符串", "set": { "supported_in_api": "yes" }, "valid": false },
    { "name": "可缺省的布尔字段不能为 null", "set": { "node_repl_disabled": null }, "valid": false },
    { "name": "缺少模型指令", "remove": ["model_messages"], "valid": false },
    { "name": "模型指令不能只有空白", "set": { "model_messages": { "instructions_template": "   " } }, "valid": false },
    { "name": "model_messages 必须是对象", "set": { "model_messages": "You are Codex." }, "valid": false },
    { "name": "能力中不能重复定义 slug", "set": { "slug": "other-model" }, "valid": false }
  ]
}
